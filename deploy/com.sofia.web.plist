<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The web app, behind nginx (deploy/nginx-sofia.conf). launchd needs
  absolute paths: replace __REPO__ with the repository's path when
  copying this into ~/Library/LaunchAgents (see the README).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sofia.web</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/deploy/run.sh</string>
        <string>uvicorn</string>
        <string>web.app:app</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8437</string>
        <string>--workers</string>
        <string>2</string>
        <string>--proxy-headers</string>
        <string>--forwarded-allow-ips</string>
        <string>127.0.0.1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart it if it exits, but at most every 10 s. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>__REPO__/logs/web.log</string>
    <key>StandardErrorPath</key>
    <string>__REPO__/logs/web.log</string>
</dict>
</plist>
